# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Direct connection for Prisma migrations (bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Local app runtime
NODE_ENV=development
APP_NAME="SIS Restaurante"
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://sis:sis@localhost:5432/sis_restaurante?schema=public

# Shared auth/runtime
SESSION_SECRET=0123456789abcdef0123456789abcdef
LOG_LEVEL=info

# Local Docker database
POSTGRES_DB=sis_restaurante
POSTGRES_USER=sis
POSTGRES_PASSWORD=sis
POSTGRES_EXPOSE_PORT=5432

# Production compose overrides
DATABASE_URL_DOCKER=postgresql://sis:sis@db:5432/sis_restaurante?schema=public
PROXY_HTTP_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=20m
RUN_DB_SEED=false
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24

# Mercado Pago — Integração de pagamentos
# Obter em: Mercado Pago > Suas integrações > Credenciais
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
# Assinatura secreta dos webhooks (Mercado Pago > Suas integrações > Webhooks).
# O painel gera um secret por modo (teste e produção) e os dois entregam na
# mesma URL — separe por vírgula para a rota aceitar ambos.
MERCADOPAGO_WEBHOOK_SECRET=secret_de_teste,secret_de_producao

# Resend — Provedor de E-mails Transacionais
# Obter chave de API em: resend.com > API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM="SIS Restaurante <onboarding@resend.dev>"

# Sentry — Monitoramento de Erros e Exceções
# Obter DSN no painel do Sentry
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0000000
