# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Direct connection for Prisma migrations (bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Local app runtime
NODE_ENV=development
APP_NAME="SIS Restaurante"
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://sis:sis@localhost:5432/sis_restaurante?schema=public

# Shared auth/runtime
SESSION_SECRET=0123456789abcdef0123456789abcdef
LOG_LEVEL=info

# Local Docker database
POSTGRES_DB=sis_restaurante
POSTGRES_USER=sis
POSTGRES_PASSWORD=sis
POSTGRES_EXPOSE_PORT=5432

# Production compose overrides
DATABASE_URL_DOCKER=postgresql://sis:sis@db:5432/sis_restaurante?schema=public
PROXY_HTTP_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=20m
RUN_DB_SEED=false
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24

# Asaas — Integração de pagamentos
# Obter em: asaas.com > Integrações > Chaves de API
ASAAS_API_KEY=$aact_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ASAAS_WALLET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "sandbox" para testes, "production" para produção
ASAAS_ENV=sandbox
# Token para validar os webhooks recebidos (definir em Asaas > Integrações > Webhooks)
ASAAS_WEBHOOK_TOKEN=seu_token_secreto_aqui
