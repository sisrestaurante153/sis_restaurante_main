generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  insumo
  pre_preparo
  intermediario
  produto_pronto
  prato
  porcao
  marmita
  combo
  embalagem
  apoio
}

enum UnidadeTipo {
  massa
  volume
  contagem
}

enum FichaStatus {
  rascunho
  ativa
  inativa
  arquivada
}

enum ModoRendimento {
  percentual_perda
  peso_final
}

enum TipoComponente {
  ingrediente
  embalagem
  apoio
}

enum ImportacaoStatus {
  pendente
  processando
  concluida
  concluida_com_conflitos
  falha
}

enum ImportacaoLinhaStatus {
  pending
  imported
  conflict
  skipped
}

model Item {
  id                  String            @id @default(cuid())
  codigoInterno       String?           @unique @map("codigo_interno")
  nome                String
  nomeNormalizado     String            @unique @map("nome_normalizado")
  descricao           String?
  categoriaOperacional String?          @map("categoria_operacional")
  tipoPrincipal       ItemType          @map("tipo_principal")
  unidadeEstoqueId    String?           @map("unidade_estoque_id")
  unidadeUsoPadraoId  String?           @map("unidade_uso_padrao_id")
  ativo               Boolean           @default(true)
  observacoes         String?
  criadoEm            DateTime          @default(now()) @map("criado_em")
  atualizadoEm        DateTime          @updatedAt @map("atualizado_em")
  unidadeEstoque      UnidadeMedida?    @relation("ItemUnidadeEstoque", fields: [unidadeEstoqueId], references: [id])
  unidadeUsoPadrao    UnidadeMedida?    @relation("ItemUnidadeUsoPadrao", fields: [unidadeUsoPadraoId], references: [id])
  aliases             ItemAlias[]
  conversoes          ConversaoUnidade[]
  compras             ItemCompra[]
  fichasResultantes   FichaTecnica[]
  componentesUsados   FichaComponente[]
  custosSnapshot      CustoSnapshotItem[]
  dependenciasComoAscendente DependenciaItem[] @relation("DependenciaAscendente")
  dependenciasComoDescendente DependenciaItem[] @relation("DependenciaDescendente")
  execucoesCalculo        CalculoExecucao[] @relation("CalculoExecucaoItem")
  execucoesGatilho        CalculoExecucao[] @relation("CalculoExecucaoGatilho")
  componentesCalculados   CalculoComponenteSnapshot[]
  stagingRows         ImportacaoStaging[]

  @@index([tipoPrincipal])
  @@index([unidadeEstoqueId])
  @@index([unidadeUsoPadraoId])
  @@map("item")
}

model ItemAlias {
  id              String    @id @default(cuid())
  itemId          String    @map("item_id")
  alias           String
  aliasNormalizado String   @map("alias_normalizado")
  origem          String
  confianca       Decimal?  @db.Decimal(5, 2)
  validadoPor     String?   @map("validado_por")
  validadoEm      DateTime? @map("validado_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, aliasNormalizado])
  @@index([aliasNormalizado])
  @@map("item_alias")
}

model UnidadeMedida {
  id                  String             @id @default(cuid())
  codigo              String             @unique
  nome                String
  tipo                UnidadeTipo
  ativo               Boolean            @default(true)
  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")
  conversoesOrigem    ConversaoUnidade[] @relation("ConversaoOrigem")
  conversoesDestino   ConversaoUnidade[] @relation("ConversaoDestino")
  itensCompraUnidadeCompra ItemCompra[]  @relation("ItemCompraUnidadeCompra")
  itensCompraUnidadeUso    ItemCompra[]  @relation("ItemCompraUnidadeUso")
  componentes         FichaComponente[]
  itensComoUnidadeEstoque Item[]         @relation("ItemUnidadeEstoque")
  itensComoUnidadeUsoPadrao Item[]       @relation("ItemUnidadeUsoPadrao")
  fichasComoUnidadeRendimento FichaTecnica[] @relation("FichaUnidadeRendimento")

  @@map("unidade_medida")
}

model ConversaoUnidade {
  id               String        @id @default(cuid())
  itemId           String?       @map("item_id")
  unidadeOrigemId  String        @map("unidade_origem_id")
  unidadeDestinoId String        @map("unidade_destino_id")
  fator            Decimal       @db.Decimal(18, 6)
  observacao       String?
  origem           String?
  criadoEm         DateTime      @default(now()) @map("criado_em")
  item             Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unidadeOrigem    UnidadeMedida @relation("ConversaoOrigem", fields: [unidadeOrigemId], references: [id])
  unidadeDestino   UnidadeMedida @relation("ConversaoDestino", fields: [unidadeDestinoId], references: [id])

  @@unique([itemId, unidadeOrigemId, unidadeDestinoId])
  @@index([unidadeOrigemId, unidadeDestinoId])
  @@map("conversao_unidade")
}

model Fornecedor {
  id           String       @id @default(cuid())
  nome         String       @unique
  contato      String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")
  compras      ItemCompra[]

  @@map("fornecedor")
}

model TipoItemCadastro {
  id           String    @id @default(cuid())
  codigo       ItemType  @unique
  nome         String
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@map("tipo_item_cadastro")
}

model CategoriaOperacional {
  id           String    @id @default(cuid())
  codigo       String    @unique
  nome         String    @unique
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@map("categoria_operacional")
}

model Modalidade {
  id           String         @id @default(cuid())
  codigo       String         @unique
  nome         String         @unique
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")
  fichas       FichaTecnica[]

  @@map("modalidade")
}

model TipoEtapa {
  id           String       @id @default(cuid())
  codigo       String       @unique
  nome         String
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")
  etapas       FichaEtapa[]

  @@map("tipo_etapa")
}

model ItemCompra {
  id                     String         @id @default(cuid())
  itemId                 String         @map("item_id")
  fornecedorId           String         @map("fornecedor_id")
  unidadeCompraId        String         @map("unidade_compra_id")
  unidadeUsoId           String?        @map("unidade_uso_id")
  principal              Boolean        @default(false)
  quantidadePorEmbalagem Decimal        @db.Decimal(18, 4) @map("quantidade_por_embalagem")
  quantidadeUso          Decimal?       @db.Decimal(18, 4) @map("quantidade_uso")
  custoCompra            Decimal        @db.Decimal(18, 4) @map("custo_compra")
  custoUnitarioBase      Decimal        @db.Decimal(18, 6) @map("custo_unitario_base")
  dataAtualizacaoPreco   DateTime?      @map("data_atualizacao_preco")
  observacao             String?
  criadoEm               DateTime       @default(now()) @map("criado_em")
  atualizadoEm           DateTime       @updatedAt @map("atualizado_em")
  item                   Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fornecedor             Fornecedor     @relation(fields: [fornecedorId], references: [id])
  unidadeCompra          UnidadeMedida  @relation("ItemCompraUnidadeCompra", fields: [unidadeCompraId], references: [id])
  unidadeUso             UnidadeMedida? @relation("ItemCompraUnidadeUso", fields: [unidadeUsoId], references: [id])

  @@unique([itemId, fornecedorId, unidadeCompraId])
  @@index([fornecedorId])
  @@index([unidadeUsoId])
  @@map("item_compra")
}

model FichaTecnica {
  id                 String         @id @default(cuid())
  itemResultanteId   String         @map("item_resultante_id")
  nomeExibicao       String?        @map("nome_exibicao")
  modalidadeId       String?        @map("modalidade_id")
  unidadeRendimentoId String?       @map("unidade_rendimento_id")
  versao             Int
  status             FichaStatus
  modoRendimento     ModoRendimento @map("modo_rendimento")
  percentualPerda    Decimal?       @db.Decimal(7, 4) @map("percentual_perda")
  pesoFinalInformado Decimal?       @db.Decimal(18, 4) @map("peso_final_informado")
  rendimentoPorcoes  Decimal?       @db.Decimal(18, 4) @map("rendimento_porcoes")
  precoVenda         Decimal?       @db.Decimal(18, 4) @map("preco_venda")
  despesaVariavelPercentual Decimal? @db.Decimal(7, 4) @map("despesa_variavel_percentual")
  modoPreparo        String?        @map("modo_preparo")
  observacoes        String?
  criadaPorId        String?        @map("criada_por_id")
  criadaEm           DateTime       @default(now()) @map("criada_em")
  atualizadaEm       DateTime       @updatedAt @map("atualizada_em")
  itemResultante     Item           @relation(fields: [itemResultanteId], references: [id], onDelete: Cascade)
  modalidade         Modalidade?    @relation(fields: [modalidadeId], references: [id], onDelete: SetNull)
  unidadeRendimento  UnidadeMedida? @relation("FichaUnidadeRendimento", fields: [unidadeRendimentoId], references: [id], onDelete: SetNull)
  criadaPor          User?          @relation(fields: [criadaPorId], references: [id])
  componentes        FichaComponente[]
  etapas             FichaEtapa[]
  execucoesCalculo   CalculoExecucao[]
  stagingRows        ImportacaoStaging[]

  @@unique([itemResultanteId, versao])
  @@index([itemResultanteId, status])
  @@index([modalidadeId])
  @@index([unidadeRendimentoId])
  @@map("ficha_tecnica")
}

model FichaEtapa {
  id                 String           @id @default(cuid())
  fichaTecnicaId     String           @map("ficha_tecnica_id")
  tipoEtapaId        String?          @map("tipo_etapa_id")
  ordem              Int
  nome               String
  pesoEntrada        Decimal?         @db.Decimal(18, 4) @map("peso_entrada")
  pesoSaida          Decimal?         @db.Decimal(18, 4) @map("peso_saida")
  fatorCorrecao      Decimal?         @db.Decimal(18, 6) @map("fator_correcao")
  indiceCoccao       Decimal?         @db.Decimal(18, 6) @map("indice_coccao")
  valorTotalSnapshot Decimal?         @db.Decimal(18, 6) @map("valor_total_snapshot")
  observacao         String?
  criadoEm           DateTime         @default(now()) @map("criado_em")
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em")
  fichaTecnica       FichaTecnica     @relation(fields: [fichaTecnicaId], references: [id], onDelete: Cascade)
  tipoEtapa          TipoEtapa?       @relation(fields: [tipoEtapaId], references: [id], onDelete: SetNull)
  componentes        FichaComponente[]

  @@unique([fichaTecnicaId, ordem])
  @@index([tipoEtapaId])
  @@map("ficha_etapa")
}

model FichaComponente {
  id                    String         @id @default(cuid())
  fichaTecnicaId        String         @map("ficha_tecnica_id")
  fichaEtapaId          String?        @map("ficha_etapa_id")
  itemComponenteId      String         @map("item_componente_id")
  tipoComponente        TipoComponente @map("tipo_componente")
  ordem                 Int
  quantidadeBruta       Decimal        @db.Decimal(18, 4) @map("quantidade_bruta")
  quantidadeLimpa       Decimal?       @db.Decimal(18, 4) @map("quantidade_limpa")
  unidadeUsoId          String         @map("unidade_uso_id")
  fatorCorrecao         Decimal?       @db.Decimal(18, 6) @map("fator_correcao")
  indiceCoccao          Decimal?       @db.Decimal(18, 6) @map("indice_coccao")
  custoUnitarioSnapshot Decimal?       @db.Decimal(18, 6) @map("custo_unitario_snapshot")
  custoTotalSnapshot    Decimal?       @db.Decimal(18, 6) @map("custo_total_snapshot")
  observacao            String?
  criadoEm              DateTime       @default(now()) @map("criado_em")
  atualizadoEm          DateTime       @updatedAt @map("atualizado_em")
  fichaTecnica          FichaTecnica   @relation(fields: [fichaTecnicaId], references: [id], onDelete: Cascade)
  fichaEtapa            FichaEtapa?    @relation(fields: [fichaEtapaId], references: [id], onDelete: SetNull)
  itemComponente        Item           @relation(fields: [itemComponenteId], references: [id], onDelete: Restrict)
  unidadeUso            UnidadeMedida  @relation(fields: [unidadeUsoId], references: [id])
  snapshotsCalculo      CalculoComponenteSnapshot[]

  @@unique([fichaTecnicaId, ordem])
  @@index([itemComponenteId])
  @@index([fichaEtapaId])
  @@map("ficha_componente")
}

model CustoSnapshotItem {
  id                    String   @id @default(cuid())
  itemId                String   @map("item_id")
  calculoExecucaoId     String?  @map("calculo_execucao_id")
  custoUnitarioAtual    Decimal  @db.Decimal(18, 6) @map("custo_unitario_atual")
  custoPorKgOuUnidadeUso Decimal? @db.Decimal(18, 6) @map("custo_por_kg_ou_unidade_uso")
  custoEmbalagemAtual   Decimal? @db.Decimal(18, 6) @map("custo_embalagem_atual")
  custoTotalAtual       Decimal  @db.Decimal(18, 6) @map("custo_total_atual")
  calculadoEm           DateTime @default(now()) @map("calculado_em")
  origemRecalculo       String?  @map("origem_recalculo")
  item                  Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  calculoExecucao       CalculoExecucao? @relation(fields: [calculoExecucaoId], references: [id], onDelete: SetNull)

  @@index([itemId, calculadoEm])
  @@index([calculoExecucaoId])
  @@map("custo_snapshot_item")
}

model DependenciaItem {
  id                String   @id @default(cuid())
  itemAscendenteId  String   @map("item_ascendente_id")
  itemDescendenteId String   @map("item_descendente_id")
  profundidade      Int
  relacaoDireta     Boolean  @default(false) @map("relacao_direta")
  criadoEm          DateTime @default(now()) @map("criado_em")
  itemAscendente    Item     @relation("DependenciaAscendente", fields: [itemAscendenteId], references: [id], onDelete: Cascade)
  itemDescendente   Item     @relation("DependenciaDescendente", fields: [itemDescendenteId], references: [id], onDelete: Cascade)

  @@unique([itemAscendenteId, itemDescendenteId])
  @@index([itemDescendenteId, profundidade])
  @@index([itemAscendenteId, profundidade])
  @@map("dependencia_item")
}

model User {
  id           String      @id @default(cuid())
  nome         String
  email        String      @unique
  senhaHash    String?     @map("senha_hash")
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  fichasCriadas FichaTecnica[]
  auditorias   Auditoria[]
  importacoesSolicitadas ImportacaoExecucao[] @relation("ImportacaoSolicitadaPor")
  roles        UserRole[]

  @@map("usuario")
}

model Role {
  id           String           @id @default(cuid())
  codigo       String           @unique
  nome         String
  descricao    String?
  criadaEm     DateTime         @default(now()) @map("criada_em")
  atualizadaEm DateTime         @updatedAt @map("atualizada_em")
  usuarios     UserRole[]
  permissoes   RolePermission[]

  @@map("role")
}

model Permission {
  id           String           @id @default(cuid())
  codigo       String           @unique
  nome         String
  descricao    String?
  criadaEm     DateTime         @default(now()) @map("criada_em")
  atualizadaEm DateTime         @updatedAt @map("atualizada_em")
  roles        RolePermission[]

  @@map("permissao")
}

model UserRole {
  userId      String   @map("user_id")
  roleId      String   @map("role_id")
  atribuidaEm DateTime @default(now()) @map("atribuida_em")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("usuario_role")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  concedidaEm  DateTime   @default(now()) @map("concedida_em")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissao")
}

model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?  @map("usuario_id")
  entidade   String
  entidadeId String   @map("entidade_id")
  acao       String
  antesJson  Json?    @map("antes_json")
  depoisJson Json?    @map("depois_json")
  criadoEm   DateTime @default(now()) @map("criado_em")
  usuario    User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@map("auditoria")
}

model ImportacaoExecucao {
  id                   String              @id @default(cuid())
  origemArquivo        String              @map("origem_arquivo")
  origemArquivoCaminho String?             @map("origem_arquivo_caminho")
  mimeTypeArquivo      String?             @map("mime_type_arquivo")
  tamanhoArquivoBytes  Int?                @map("tamanho_arquivo_bytes")
  hashArquivo          String?             @map("hash_arquivo")
  status               ImportacaoStatus    @default(pendente)
  estagioAtual         String              @default("aguardando_worker") @map("estagio_atual")
  resumoJson           Json?               @map("resumo_json")
  resumoAmigavelJson   Json?               @map("resumo_amigavel_json")
  detalhesTecnicosJson Json?               @map("detalhes_tecnicos_json")
  artefatosJson        Json?               @map("artefatos_json")
  solicitadoPorId      String?             @map("solicitado_por_id")
  criadoEm             DateTime            @default(now()) @map("criado_em")
  iniciadoEm           DateTime?           @map("iniciado_em")
  finalizadoEm         DateTime?           @map("finalizado_em")
  solicitadoPor        User?               @relation("ImportacaoSolicitadaPor", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  stagingRows          ImportacaoStaging[]
  conflitos            ImportacaoConflito[]

  @@index([status, criadoEm])
  @@index([solicitadoPorId])
  @@map("importacao_execucao")
}

model ImportacaoStaging {
  id             String               @id @default(cuid())
  execucaoId     String               @map("execucao_id")
  entidade       String
  chaveExterna   String               @map("chave_externa")
  sheetName      String?              @map("sheet_name")
  rowNumber      Int?                 @map("row_number")
  payloadJson    Json                 @map("payload_json")
  status         ImportacaoLinhaStatus @default(pending)
  itemId         String?              @map("item_id")
  fichaTecnicaId String?              @map("ficha_tecnica_id")
  criadoEm       DateTime             @default(now()) @map("criado_em")
  atualizadoEm   DateTime             @updatedAt @map("atualizado_em")
  execucao       ImportacaoExecucao   @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  item           Item?                @relation(fields: [itemId], references: [id], onDelete: SetNull)
  fichaTecnica   FichaTecnica?        @relation(fields: [fichaTecnicaId], references: [id], onDelete: SetNull)
  conflitos      ImportacaoConflito[]

  @@unique([execucaoId, entidade, chaveExterna])
  @@index([sheetName, rowNumber])
  @@index([status])
  @@map("importacao_staging")
}

model ImportacaoConflito {
  id             String             @id @default(cuid())
  execucaoId     String             @map("execucao_id")
  stagingId      String?            @map("staging_id")
  tipo           String
  rawName        String?            @map("raw_name")
  normalizedName String?            @map("normalized_name")
  sheetName      String?            @map("sheet_name")
  rowNumber      Int?               @map("row_number")
  confidence     Decimal?           @db.Decimal(5, 4)
  detalhesJson   Json?              @map("detalhes_json")
  resolvido      Boolean            @default(false)
  criadoEm       DateTime           @default(now()) @map("criado_em")
  execucao       ImportacaoExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  staging        ImportacaoStaging? @relation(fields: [stagingId], references: [id], onDelete: SetNull)

  @@index([tipo, resolvido])
  @@index([sheetName, rowNumber])
  @@map("importacao_conflito")
}

model CalculoExecucao {
  id                String                     @id @default(cuid())
  itemId            String                     @map("item_id")
  fichaTecnicaId    String?                    @map("ficha_tecnica_id")
  itemGatilhoId     String?                    @map("item_gatilho_id")
  motivo            String
  custoAnterior     Decimal?                   @db.Decimal(18, 6) @map("custo_anterior")
  custoNovo         Decimal                    @db.Decimal(18, 6) @map("custo_novo")
  quantidadeSaida   Decimal                    @db.Decimal(18, 6) @map("quantidade_saida")
  metadadosJson     Json?                      @map("metadados_json")
  criadoEm          DateTime                   @default(now()) @map("criado_em")
  item              Item                       @relation("CalculoExecucaoItem", fields: [itemId], references: [id], onDelete: Cascade)
  itemGatilho       Item?                      @relation("CalculoExecucaoGatilho", fields: [itemGatilhoId], references: [id], onDelete: SetNull)
  fichaTecnica      FichaTecnica?              @relation(fields: [fichaTecnicaId], references: [id], onDelete: SetNull)
  snapshotsCusto    CustoSnapshotItem[]
  snapshotsComponente CalculoComponenteSnapshot[]

  @@index([itemId, criadoEm])
  @@index([itemGatilhoId])
  @@map("calculo_execucao")
}

model CalculoComponenteSnapshot {
  id                       String           @id @default(cuid())
  calculoExecucaoId        String           @map("calculo_execucao_id")
  fichaComponenteId        String?          @map("ficha_componente_id")
  itemComponenteId         String           @map("item_componente_id")
  caminho                  String
  profundidade             Int
  tipoComponente           TipoComponente   @map("tipo_componente")
  quantidadeBruta          Decimal          @db.Decimal(18, 6) @map("quantidade_bruta")
  quantidadeLiquida        Decimal          @db.Decimal(18, 6) @map("quantidade_liquida")
  fatorCorrecaoEquivalente Decimal          @db.Decimal(18, 6) @map("fator_correcao_equivalente")
  indiceCoccaoEquivalente  Decimal?         @db.Decimal(18, 6) @map("indice_coccao_equivalente")
  custoDireto              Decimal          @db.Decimal(18, 6) @map("custo_direto")
  custoHerdado             Decimal          @db.Decimal(18, 6) @map("custo_herdado")
  custoTotal               Decimal          @db.Decimal(18, 6) @map("custo_total")
  percentualImpacto        Decimal?         @db.Decimal(18, 6) @map("percentual_impacto")
  criadoEm                 DateTime         @default(now()) @map("criado_em")
  calculoExecucao          CalculoExecucao  @relation(fields: [calculoExecucaoId], references: [id], onDelete: Cascade)
  itemComponente           Item             @relation(fields: [itemComponenteId], references: [id], onDelete: Restrict)
  fichaComponente          FichaComponente? @relation(fields: [fichaComponenteId], references: [id], onDelete: SetNull)

  @@index([calculoExecucaoId, profundidade])
  @@index([itemComponenteId])
  @@map("calculo_componente_snapshot")
}
