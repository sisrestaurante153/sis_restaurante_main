# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Transaction pooler (app) and direct connection (migrations)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public runtime
NODE_ENV=production
APP_NAME="SIS Restaurante"
# If the app is published under a subpath, include it here. Example:
# APP_URL=https://sua-url-publica.exemplo/sisfichas
APP_URL=https://sua-url-publica.exemplo
LOG_LEVEL=info
SESSION_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres

# Database
POSTGRES_DB=sis_restaurante
POSTGRES_USER=sis
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_EXPOSE_PORT=5432
DATABASE_URL=postgresql://sis:troque-esta-senha@127.0.0.1:5432/sis_restaurante?schema=public
DATABASE_URL_DOCKER=postgresql://sis:troque-esta-senha@db:5432/sis_restaurante?schema=public

# Reverse proxy and bootstrap
PROXY_HTTP_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=64m
RUN_DB_SEED=false

# Backup sidecar
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24
